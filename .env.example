# Copy this file to .env.local. Never commit .env.local or real credentials.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_HOST_PORT=3000
API_HOST_PORT=8000

# Local-only development login. Omit the NEXT_PUBLIC values from real production builds.
DEV_ACCOUNT_EMAIL=dev@fomo.local
DEV_ACCOUNT_PASSWORD=fomo-dev-password
DEV_ACCOUNT_DISPLAY_NAME=Dev
NEXT_PUBLIC_DEV_ACCOUNT_EMAIL=dev@fomo.local
NEXT_PUBLIC_DEV_ACCOUNT_PASSWORD=fomo-dev-password

# Local-only values may use these examples. Generate new random values in production.
SESSION_COOKIE_NAME=fomo_session
SESSION_SIGNING_KEY=dev-session-signing-key-change-before-production-0123456789
CSRF_SIGNING_KEY=dev-csrf-signing-key-change-before-production-0123456789

# -----------------------------------------------------------------------------
# PostgreSQL — local Docker service
# -----------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
POSTGRES_DB=fomo
POSTGRES_USER=fomo
POSTGRES_PASSWORD=fomo-local-only
DATABASE_URL=postgresql+asyncpg://fomo:fomo-local-only@localhost:5432/fomo
DATABASE_URL_DOCKER=postgresql+asyncpg://fomo:fomo-local-only@postgres:5432/fomo

# -----------------------------------------------------------------------------
# Redis / Celery — local Docker service
# -----------------------------------------------------------------------------
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BROKER_URL_DOCKER=redis://redis:6379/1

# -----------------------------------------------------------------------------
# S3-compatible object storage — MinIO in local development
# These are local MinIO credentials, not cloud keys. Replace them in production.
# -----------------------------------------------------------------------------
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=fomo
MINIO_ROOT_PASSWORD=fomo-minio-local-only-0123456789
S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=fomo-artifacts
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=fomo
AWS_SECRET_ACCESS_KEY=fomo-minio-local-only-0123456789

# -----------------------------------------------------------------------------
# LiteLLM — local Docker gateway
# These keys only protect/encrypt the local gateway. Replace them in production.
# -----------------------------------------------------------------------------
LITELLM_HOST_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_BASE_URL_DOCKER=http://litellm:4000
# OpenSandbox-generated containers are not members of the Compose network.
SANDBOX_LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_DATABASE_URL_DOCKER=postgresql://fomo:fomo-local-only@postgres:5432/fomo_litellm
LITELLM_MASTER_KEY=sk-local-fomo-development-only
LITELLM_SALT_KEY=local-litellm-salt-change-before-production-0123456789
# Direct Pi gets one scoped virtual key per run. The control plane safely
# extends this minimum through the active sandbox lifetime plus cleanup grace;
# the key remains limited to the selected alias, rate and spend policy.
FOMO_INFERENCE_TOKEN_TTL=4200
INFERENCE_MANAGEMENT_TIMEOUT_SECONDS=15
RUN_MAX_SPEND=5.0
RUN_INFERENCE_RPM_LIMIT=60
RUN_INFERENCE_TPM_LIMIT=1250000
# Comma-separated public profile ids. Keep optional providers disabled until
# their bounded runtime canary succeeds with the deployment's real credential.
FOMO_RUNTIME_ENABLED_PROFILES=deepseek-flash
# Default must also be present in the enabled allowlist.
FOMO_RUNTIME_DEFAULT_PROFILE=deepseek-flash
# Coding Agent runtime is selected per run and frozen with the model contract.
FOMO_AGENT_ENABLED_FRAMEWORKS=pi,opencode,codex
FOMO_AGENT_DEFAULT_FRAMEWORK=pi
# Legacy fallback for requests without a frozen runtime profile. New runs use
# the selected profile's context metadata (for example DeepSeek 1M or GPT 250K).
PI_CONTEXT_WINDOW=200000
# Legacy four-role aliases remain during migration but are not the Direct Pi path.
MODEL_PM=pm
MODEL_ARCHITECT=architect
MODEL_ENGINEER=engineer
MODEL_REVIEWER=reviewer
# Engineer source-file sizing: aim to split at the target; only content over
# the hard limit is rejected. Both values must be positive, target <= hard,
# and the hard limit must not exceed 24000.
ENGINEER_TARGET_FILE_CHARACTERS=12000
ENGINEER_MAX_FILE_CHARACTERS=20000
# Direct Pi is the production path. Legacy modes remain only for compatibility tests.
AGENT_FRAMEWORK=direct_pi
# Strict GoalGraph planning/execution is true-default; false is P0 rollback only.
DIRECT_PI_GOAL_GRAPH_ENABLED=true

# Configure only credentials used by enabled profiles. A selected profile stays
# on the same model across planning, building, and repair; the old split aliases
# remain only for persisted-run compatibility. Anthropic serves legacy SOP aliases.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
# Optional Grok 4.5 subscription route. This secret is injected only into
# LiteLLM; never pass it to API, worker, Web, or generation sandboxes.
GROK_API_KEY=
# Optional OpenCode Zen catalog routes. This secret is injected only into
# LiteLLM; never pass it to API, worker, Web, or generation sandboxes.
OPENCODE_API_KEY=

# -----------------------------------------------------------------------------
# Optional local HTTP(S) proxy — disabled by default
# -----------------------------------------------------------------------------
# A desktop proxy may listen on the macOS host at http://127.0.0.1:7890. Docker
# containers cannot use that loopback address directly: opt in with the Docker
# Desktop hostname below only when the proxy is actually running. Do not put
# proxy credentials here; these values become container/build environment.
# DOCKER_HTTP_PROXY=http://host.docker.internal:7890
# DOCKER_HTTPS_PROXY=http://host.docker.internal:7890
# DOCKER_NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,minio,minio-init,litellm,opensandbox,api,worker,web,api.deepseek.com
# Generated-code sandbox egress is separately opt-in. It never inherits the
# DOCKER_* values, so set it explicitly only if generated projects need pnpm.
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7890
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7890
# SANDBOX_NO_PROXY=localhost,127.0.0.1,::1

# -----------------------------------------------------------------------------
# Sandbox — OpenSandbox Server with the local Docker runtime
# No external sandbox account or API key is required for local development.
# The lifecycle API stays on localhost; Compose API/worker services should use
# OPENSANDBOX_BASE_URL_DOCKER instead of mounting the Docker socket themselves.
# -----------------------------------------------------------------------------
SANDBOX_PROVIDER=opensandbox
OPENSANDBOX_HOST_PORT=8080
OPENSANDBOX_BASE_URL=http://localhost:8080
OPENSANDBOX_BASE_URL_DOCKER=http://opensandbox:8080
OPENSANDBOX_API_KEY=fomo-opensandbox-local-development-only
OPENSANDBOX_READY_TIMEOUT_SECONDS=120
OPENSANDBOX_IMAGE=fomo-sandbox-node:2026-08-08
# Must not exceed the OpenSandbox server hard limit in infra/opensandbox/config.toml.
OPENSANDBOX_LIFETIME_SECONDS=21600
# A fully verified Preview is retained for seven days; generation sandboxes
# still use the shorter lifetime above.
VERIFIED_PREVIEW_LIFETIME_SECONDS=604800
OPENSANDBOX_RUNTIME=docker
# Public Preview modes are mutually exclusive. URL mode can use the existing
# web origin plus /preview. In production, leaving both values empty derives
# WEB_ORIGIN/preview and keeps generated pages in an opaque CSP sandbox.
# A fixed dedicated cross-site HTTPS URL (for example an sslip.io hostname
# routed through a tunnel) enables forms, hydration, and
# localStorage while framing remains limited to WEB_ORIGIN. This is a trusted,
# single-tenant demo mode: all Preview IDs share the tunnel origin and browser
# storage. CSP URL paths are defense in depth only (redirect handling is not a
# path-isolation boundary). Same-site URL mode must use WEB_ORIGIN itself;
# non-loopback URLs require HTTPS. Use wildcard mode for untrusted previews.
PUBLIC_PREVIEW_BASE_URL=
# Optional stronger isolation: use a dedicated cross-site wildcard domain
# (without scheme/port), for example fomo-previews.example.net.
# Route *.fomo-previews.example.net to the optional preview-gateway profile and
# provision wildcard TLS for that exact depth. Do not reuse the app eTLD+1.
PUBLIC_PREVIEW_BASE_DOMAIN=
PREVIEW_GATEWAY_INTERNAL_URL=http://preview-gateway:8001
PREVIEW_GATEWAY_HOST_PORT=8001
# The gateway runs in Compose while OpenSandbox publishes random host ports.
PREVIEW_UPSTREAM_HOST_OVERRIDE=host.docker.internal

# The named Cloudflare Tunnel config is intentionally external to Compose; see
# deploy/cloudflared/config.example.yml. Never put its credentials JSON here or
# in Git. The origin firewall exposes no database, Redis, MinIO, LiteLLM,
# OpenSandbox lifecycle, or random Preview host port to the public Internet.

# -----------------------------------------------------------------------------
# Optional integrations — leave empty for local development
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
